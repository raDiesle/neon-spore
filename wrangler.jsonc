{
  "name": "neon-spore",
  "main": "./apps/server/src/index.ts",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./apps/game/dist"
  },
  // One Durable Object per room, addressed by the four-character code the two
  // players read to each other. See apps/server/README.md.
  //
  // And exactly one more, holding every claimed name: uniqueness needs
  // somewhere to be unique in, and a room is the wrong place because rooms
  // come and go while the pair who play tomorrow are the same two people.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "NAMES", "class_name": "Names" }
    ]
  },
  // The Firebase project whose sign-ins the registry trusts (`sign-in.ts`) —
  // the `projectId` of `apps/game/src/sign-in-config.ts`, pasted by the owner
  // on 13 September 2026. Emptied, every claim is anonymous again.
  // `SIGN_IN_KEYS` is the test's, and is never set here.
  "vars": { "FIREBASE_PROJECT": "neon-spore" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Names"] }
  ]
}
