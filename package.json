{
  "name": "neon-spore",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun tools/dev/supervise.ts bun --hot tools/director/server.ts",
    "dev:once": "DIRECTOR_PORT=0 bun tools/dev/supervise.ts --pin=DIRECTOR_PORT bun --hot tools/director/server.ts",
    "dev:here": "DIRECTOR_PORT=0 bun tools/dev/supervise.ts --here --pin=DIRECTOR_PORT bun --hot tools/director/server.ts",
    "here": "bun tools/dev/here.ts",
    "dev:game": "bun tools/dev/supervise.ts bun --hot apps/game/index.html --port 3000",
    "build": "bun run build:game && bun run build:director",
    "build:game": "bun run --cwd apps/game build",
    "build:director": "bun tools/director/build.ts",
    "preview": "bun run --cwd apps/game preview",
    "preview:once": "bun run --cwd apps/game preview:once",
    "preview:here": "bun tools/dev/preview-here.ts",
    "deploy": "bun run build:director && npx wrangler deploy --config wrangler.director.jsonc",
    "deploy:dry": "bun run build:director && npx wrangler deploy --config wrangler.director.jsonc --dry-run",
    "deploy:game": "bun run build:game && npx wrangler deploy --config wrangler.jsonc",
    "deploy:game:dry": "bun run build:game && npx wrangler deploy --config wrangler.jsonc --dry-run",
    "delegate": "bun run tools/delegate/run.ts",
    "orphans": "bun run tools/orphans/run.ts",
    "maze": "bun run tools/maze/run.ts",
    "perf": "bun run tools/perf/run.ts",
    "baseline:blank": "bun run tools/perf/blank.ts",
    "port": "bun run tools/port.ts",
    "probe": "bun run tools/probe/run.ts",
    "queue": "bun run tools/queue/run.ts",
    "index": "bun run tools/index/run.ts",
    "words": "bun run tools/words/run.ts",
    "imports": "bun run tools/imports/run.ts",
    "imports:sort": "biome check --write --only=assist/source/organizeImports .",
    "land": "bun run tools/land/run.ts",
    "sweep": "bun run tools/land/run.ts --sweep",
    "push": "bun run tools/land/push.ts",
    "reconcile": "bun run tools/land/reconcile-run.ts",
    "unverified": "bun run tools/land/unverified-run.ts",
    "scope": "bun run tools/hooks/scope.ts",
    "versus": "bun run tools/versus/run.ts",
    "frames": "bun run tools/frames/run.ts",
    "raster": "bun run tools/raster/run.ts",
    "raster:pack": "bun run tools/raster/pack.ts",
    "raster:verify": "bun run tools/raster/verify.ts",
    "png": "bun run tools/frames/svg.ts",
    "icons": "bun run tools/icons/run.ts",
    "shot": "bun run tools/frames/shot.ts",
    "sheet": "bun run tools/frames/sheet.ts",
    "menu-shot": "bun run tools/frames/menu-shot.ts",
    "room-shot": "bun run tools/frames/room-shot.ts",
    "crop": "bun run tools/frames/crop-png.ts",
    "pair": "bun run tools/frames/pair-png.ts",
    "versus:shot": "bun run tools/frames/versus-shot.ts",
    "test": "bun run tools/check/shard.ts",
    "test:determinism": "bun test packages/sim/test/determinism.test.ts",
    "test:profile": "bun run tools/check/profile.ts",
    "relay:check": "bun run --cwd tools/relay-check check",
    "relay:check:all": "bun run --cwd tools/relay-check all",
    "typecheck": "tsc --noEmit && bun run --cwd apps/server typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --assist-enabled=false .",
    "check": "bun run tools/check/run.ts && bun run typecheck && bun run lint && bun run tools/check/shard.ts",
    "check:fast": "bun run tools/check/run.ts && bun run typecheck && bun run lint && bun run tools/check/fast.ts",
    "shapes": "bun run --cwd tools/shape-sheet sheets",
    "shapes:cues": "bun run --cwd tools/shape-sheet cues",
    "shapes:parts": "bun run --cwd tools/shape-sheet parts",
    "shapes:swim": "bun run --cwd tools/shape-sheet swim",
    "shapes:report": "bun run --cwd tools/shape-sheet report",
    "shapes:page": "bun run --cwd tools/director shapes-page",
    "shapes:still": "bun run --cwd tools/director shapes-still",
    "style-guide": "bun run --cwd tools/style-guide build",
    "breaks": "bun run --cwd tools/breaks build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
