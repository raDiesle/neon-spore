{
  "name": "neon-spore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun --hot apps/game/index.html --port 3000",
    "build": "bun run --cwd apps/game build",
    "preview": "bun run --cwd apps/game preview",
    "preview:once": "bun run --cwd apps/game preview:once",
    "director": "bun run --cwd tools/director start",
    "delegate": "bun run tools/delegate/run.ts",
    "test": "bun test",
    "test:determinism": "bun test packages/sim/test/determinism.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "shapes": "bun run --cwd tools/shape-sheet sheets",
    "shapes:report": "bun run --cwd tools/shape-sheet report"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
