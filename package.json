{
  "name": "neon-spore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun --hot tools/director/server.ts",
    "dev:once": "DIRECTOR_PORT=0 bun --hot tools/director/server.ts",
    "dev:game": "bun --hot apps/game/index.html --port 3000",
    "build": "bun run build:game && bun run build:director",
    "build:game": "bun run --cwd apps/game build",
    "build:director": "bun tools/director/build.ts",
    "preview": "bun run --cwd apps/game preview",
    "preview:once": "bun run --cwd apps/game preview:once",
    "deploy": "bun run build:game && npx wrangler deploy --config wrangler.jsonc",
    "deploy:dry": "bun run build:game && npx wrangler deploy --config wrangler.jsonc --dry-run",
    "delegate": "bun run tools/delegate/run.ts",
    "checks": "bun run tools/checks/run.ts",
    "orphans": "bun run tools/orphans/run.ts",
    "handoff": "bun run tools/handoff/run.ts",
    "burn": "bun run tools/burn/run.ts",
    "land": "bun run tools/land/run.ts",
    "versus": "bun run tools/versus/run.ts",
    "frames": "bun run tools/frames/run.ts",
    "png": "bun run tools/frames/svg.ts",
    "test": "bun test",
    "test:determinism": "bun test packages/sim/test/determinism.test.ts",
    "relay:check": "bun run --cwd tools/relay-check check",
    "typecheck": "tsc --noEmit && bun run --cwd apps/server typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "shapes": "bun run --cwd tools/shape-sheet sheets",
    "shapes:report": "bun run --cwd tools/shape-sheet report",
    "shapes:page": "bun run --cwd tools/director shapes-page"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
